# systemd unit for the backend (serves the built UI + API + WebSocket).
# Install on the Pi:
#   sudo cp deploy/car-telemetry.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now car-telemetry
# Edit User/paths/port to match your Pi. Build the frontend first so backend/static exists.

[Unit]
Description=Car Telemetry backend (STM32 -> Pi -> React)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/car-telemetry/backend
Environment=TELEM_MOCK=0
Environment=TELEM_SERIAL_PORT=/dev/ttyACM0
Environment=TELEM_PORT=8000
ExecStart=/usr/bin/python3 run.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
