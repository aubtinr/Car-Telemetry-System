# systemd unit for the backend (serves the built UI + API + WebSocket).
# Template: deploy/install_autostart.sh fills in __USER__, __DIR__ and __PORT__
# and installs it to /etc/systemd/system/. Re-run that script after moving the repo.

[Unit]
Description=Car Telemetry backend (STM32 -> Pi -> React)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__/backend
Environment=TELEM_MOCK=0
Environment=TELEM_SERIAL_PORT=__PORT__
Environment=TELEM_PORT=8000
ExecStart=__DIR__/backend/.venv/bin/python run.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
