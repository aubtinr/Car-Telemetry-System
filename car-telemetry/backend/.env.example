# Copy to .env and adjust. These are read by app/config.py.

# --- HTTP server ---
TELEM_HOST=0.0.0.0
TELEM_PORT=8000

# --- Mock mode (run with NO hardware) ---
# 1 = synthesize raw STM frames; 0 = open the real serial port.
TELEM_MOCK=1
# drive = calm healthy drive (demo). cycle = rotate through test scenarios.
TELEM_MOCK_SCENARIO=drive

# --- Serial link (used only when TELEM_MOCK=0) ---
# Linux (Pi):   /dev/ttyACM0  or, preferred, /dev/serial/by-id/usb-STMicro...-if00
# macOS:        /dev/tty.usbmodemXXXX
# Windows:      COM5
TELEM_SERIAL_PORT=/dev/ttyACM0
TELEM_SERIAL_BAUD=115200

# --- Freshness thresholds (ms) ---
TELEM_STM_LINK_TIMEOUT_MS=2000
TELEM_STALE_DEFAULT_MS=2000
TELEM_STALE_COOLANT_MS=5000
